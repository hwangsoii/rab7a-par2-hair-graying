# =============================================================================
# This repository holds analysis code, documentation and the small source-data
# tables needed to reproduce Figure S2B. No sequencing matrices, Seurat objects,
# figures or study-participant metadata may be committed. Workstation paths belong in
# .git/info/exclude (local) or supplementary_code/config.local.R (untracked).
# =============================================================================

# Data files: too large for git, and/or participant-level
*.rds
*.Rdata
*.RData
*.rda
*.h5
*.h5ad
*.h5seurat
*.loom
*.mtx
*.gz

# Deposition staging — participant-level matrices and cell metadata.
# These belong in the deposition archive, never in this repository.
GEO_submission/
deposition_staging/
processed_data_release/
release_staging/

# Output / binary files
*.pdf
*.tiff
*.tif
*.png
*.jpg
*.pptx
*.docx
*.zip
*.ai

# R session
.Rhistory
.RData
.Rproj.user/
*.Rproj

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Outputs (regenerated by the scripts)
figures/
results/
tmp/

# Tabular data
*.xls
*.xlsx
*.csv
*.tsv

# Machine-specific paths (never shipped)
config.local.R
supplementary_code/config.local.R

# Release sample manifest — coded identifiers only, no demographics.
# An earlier data/sample_metadata.tsv carrying exact age, sex and collection
# year is deliberately NOT re-listed here and must not be tracked again.
!data/sample_manifest.tsv

# Exact normalized values from the published external cohort used in Figure S2B.
!data/external/
!data/external/Figure_S2B_source_data.tsv
!data/external/Figure_S2B_cluster_scores.tsv
!data/external/Figure_S2B_sample_summary.tsv
